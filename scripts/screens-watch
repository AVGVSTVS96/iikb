#!/bin/bash
# Here, started by scripts/hooks/pre-push on each push: waits for the screens runs on main (.github/workflows/screens.yml)
# and, for each that ends with screens changed, has a reviewer look at them beside the commits since the run before, and
# sends Config/notify (if set) the changes no commit's message accounts for. One watcher at a time; it stops once no
# run is waiting, a few minutes after the push that started it. Each report stays in ~/.local/share/iikb/screens/<run>.
# It runs from a copy in ~/.local/state/iikb, since the worktree that pushed may be gone before the runs end.
set -euo pipefail
state=${XDG_STATE_HOME:-$HOME/.local/state}/iikb
reports=${XDG_DATA_HOME:-$HOME/.local/share}/iikb/screens
mkdir -p "$state" "$reports"
if [ "${1:-}" = --start ]; then
  main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  cp "$0" "$state/screens-watch.new" && mv "$state/screens-watch.new" "$state/screens-watch"
  setsid "$state/screens-watch" "$main" </dev/null >"$state/screens-watch.log" 2>&1 &
  exit 0
fi
cd "$1"
exec 9>"$state/screens-watch.lock"
flock -n 9 || exit 0
seen=$state/screens-seen
tell() { [ ! -x Config/notify ] || Config/notify "$1" || true; }

runs() { gh run list -w screens.yml -b main -L 10 --json databaseId,status,headSha "$@" 2>/dev/null || true; }
[ -e "$seen" ] || runs -s completed --jq '.[].databaseId' >"$seen"

review() {
  local run=$1 head=$2 folder=$reports/$1 before verdict
  gh run download "$run" -n report -D "$folder" 2>/dev/null || return 0
  grep -q '^- ' "$folder/report.md" || return 0
  before=$(cat "$folder/before")
  [ -n "$before" ] || return 0
  git fetch -q origin main
  git log --format='%h %s%n%b' "$before..$head" -- App Keyboard Packages/KeyboardModules/Sources project.yml >"$folder/commits.txt"
  verdict=$(cd "$folder" && claude -p --model sonnet --allowedTools Read 2>/dev/null <<<"Screens of iikb, an iOS keyboard and its app, changed on main. report.md has a line per changed screen, with where it changed in points and what moved, resized or reads differently there; <screen>.png is that screen before, after, and after with the change in red. commits.txt is every commit since the run before, subject and body. Look at each changed screen's picture and decide whether a commit says it would change it that way. Answer with only a line per screen no commit accounts for, '<screen>: <what changed, in a few words>', or the single word none.") || return 0
  printf '%s\n' "$verdict" >"$folder/verdict.txt"
  [ "$verdict" = none ] && return 0
  tell "Screens changed on main (${before:0:8}..${head:0:8}) that no commit says it changes:
$verdict
Before | after | change in red: $folder, run https://github.com/AVGVSTVS96/iikb/actions/runs/$run"
}

started=$(date +%s)
while :; do
  pending=0
  while read -r run status head; do
    if [ "$status" != completed ]; then
      pending=1
    elif ! grep -qx "$run" "$seen"; then
      review "$run" "$head"
      echo "$run" >>"$seen"
    fi
  done < <(runs --jq '.[] | "\(.databaseId) \(.status) \(.headSha)"')
  [ "$pending" = 1 ] || [ $(($(date +%s) - started)) -lt 300 ] || exit 0
  sleep 120
done
