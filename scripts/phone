#!/bin/sh
# Builds main for the iPhone and iPad and puts it on the install link, a page in your tailnet (Config/link,
# scripts/AGENTS.md), where you tap Install whenever you like, from any network: nothing ever installs by itself.
# It builds iikb on this Linux box with xtool and provisions it for the team's devices. The team holds one development
# certificate, and it's the Mac's: xtool's identity (~/.config/xtool/data/<team>) holds that certificate without its
# key, so xtool (Bassim's fork) makes the profiles for it and signs ad hoc, and scripts/resign signs on the Mac, whose
# login keychain has the key.
# Never let xtool revoke a certificate to make its own: that breaks what the Mac signs (stdin is closed, so it can't ask).
# It builds GitHub's main as just fetched, not this checkout's main, which an agent's uncommitted work can hold back,
# in its own worktree, so agents' branches and uncommitted edits never reach the link, and one run at a time, so agents
# running it at once queue instead of sharing that worktree. That worktree, its lock and its stamp sit beside the main
# checkout whichever worktree runs this, so every run shares one queue.
# The build number is main's commit count, which Settings › About shows as "Version 0.1.0 (<build>)". Main goes up only
# when something iikb is built from has changed since the build on the link (scripts/iphone-paths.txt), at most once
# every 10 minutes, so builds that land meanwhile go up as one; --now skips the wait, --rebuild builds even when nothing
# changed. Its build doesn't wait for a turn (~/.local/bin/turn): a build that waited for one while holding the lock
# could wait on runs queued behind it.
# Before building it runs scripts/gate and then scripts/formats on that commit, and puts up nothing that fails either.
# When main can't get onto the link (a failed check, build or signing, or the Mac not answering), Config/notify, if set
# up, is told why once, again only if the reason changes, and once more when a build goes up.
# Then it prints the build on each device the Mac reaches, which is how you know what's been tapped.
# Usage: scripts/phone [--now] [--rebuild]
set -e
cd "$(dirname "$0")/.."
now= rebuild=
for arg; do
  case $arg in
    (--now) now=1 ;;
    (--rebuild) rebuild=1 ;;
    (*) echo "usage: scripts/phone [--now] [--rebuild] (one link serves the iPhone and the iPad)" >&2; exit 2 ;;
  esac
done
main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
build=$main-build
link=$main/Config/link
[ -f "$link" ] || { echo "$link is missing: it says where the install link is served (scripts/AGENTS.md)" >&2; exit 1; }
. "$link"
page=$HOME/.local/share/iikb/link
stamp=$build.offered
blocked=$build.blocked
tell() { [ ! -x "$main/Config/notify" ] || "$main/Config/notify" "$1" || true; }
block() {
  read -r was _ 2>/dev/null < "$blocked" || was=
  [ "$was" != "$1" ] || return 0
  echo "$1 $(date +%s)" > "$blocked"
  tell "main can't get onto the iikb install link: $2.${offered:+ It stays on build $offered.} A message comes here when that clears."
}
unblock() {
  read -r _ since 2>/dev/null < "$blocked" || return 0
  rm -f "$blocked"
  tell "iikb builds are going up again: $1 (blocked since $(date -d "@$since" '+%-I:%M%P'))."
}
# Each step that can stop main names itself in `why`, which the exit reports if the run fails there.
why=
trap 'why=; exit 130' HUP INT TERM
failed() {
  [ -n "$why" ] || return 0
  ssh -o ConnectTimeout=20 mac true 2>/dev/null || why="mac the MacBook isn't answering, and every build is signed there"
  block "${why%% *}" "${why#* }"
}
trap '[ "$?" = 0 ] || failed' EXIT
# The build on each device the Mac reaches by cable or Wi-Fi, one line each.
on_devices() {
  ssh mac sh <<'MAC' || true
xcrun devicectl list devices --json-output /tmp/iikb-devices.json >/dev/null 2>&1 &&
/usr/bin/python3 -c "
import json
for d in json.load(open('/tmp/iikb-devices.json'))['result']['devices']:
    h, c = d['hardwareProperties'], d['connectionProperties']
    if h.get('reality') == 'physical' and c.get('transportType'): print(h['deviceType'], h['udid'])" |
while read -r kind udid; do
  xcrun devicectl device info apps --device "$udid" --bundle-id com.shahidy.iikb --json-output /tmp/iikb-apps.json >/dev/null 2>&1 &&
  /usr/bin/python3 -c "import json; print(next(('the $kind has build ' + a.get('bundleVersion', '?') for a in json.load(open('/tmp/iikb-apps.json'))['result']['apps']), 'the $kind has no iikb'))"
done
MAC
}
exec 9>"$build.lock"
flock 9
read -r offered from < "$stamp" 2>/dev/null || offered=
wait=$(( ${PHONE_EVERY:-600} - $(date +%s) + $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
if [ "$wait" -gt 0 ] && [ -z "$now" ]; then
  echo "the last build went up under 10 minutes ago, so this one puts up main as it is in ${wait}s, with whatever lands meanwhile" >&2
  sleep "$wait"
fi
[ -d "$build" ] || git worktree add -q --detach "$build"
why="fetch main couldn't be fetched from GitHub"
git fetch -q origin main
commit=$(git rev-parse --short origin/main)
number=$(git rev-list --count origin/main)
why=
if [ -z "$rebuild" ] && { [ "$offered" = "$number" ] ||
  git diff --quiet "$from" "$commit" -- $(git show "$commit:scripts/iphone-paths.txt" | grep -v '^#') 2>/dev/null; }; then
  echo "build $offered (main $from) is on the install link, $url/, and nothing iikb is built from has changed since"
  unblock "build $offered is on the link"
  on_devices
  exit 0
fi
git -C "$build" checkout -q -f --detach "$commit"
why="gate build $number fails the typing check (scripts/gate)"
"$build/scripts/gate" || { echo "build $number (main $commit) fails scripts/gate, so it doesn't go up" >&2; exit 1; }
why="formats build $number fails the dictation formats check (scripts/formats)"
"$build/scripts/formats" || { echo "build $number (main $commit) fails scripts/formats, so it doesn't go up" >&2; exit 1; }
why="changelog build $number's changelog couldn't be made"
for plist in Config/xtool/iikb-Info.plist Config/xtool/Keyboard-Info.plist Config/xtool/Controls-Info.plist; do
  python3 -c "import plistlib, sys; p = plistlib.load(open(sys.argv[1], 'rb')); p['CFBundleVersion'] = sys.argv[2]; plistlib.dump(p, open(sys.argv[1], 'wb'))" "$build/$plist" "$number"
done
python3 - "$build" "$commit" <<'PY'
import plistlib, subprocess, sys
build, commit = sys.argv[1], sys.argv[2]
def git(*args):
    return subprocess.run(["git", "-C", build, *args], capture_output=True, text=True, check=True).stdout
paths = [line for line in open(f"{build}/scripts/iphone-paths.txt").read().splitlines() if not line.startswith("#")]
entries = []
for line in git("log", "--format=%h%x1f%cs%x1f%(trailers:key=Changelog,valueonly,separator=%x1e)", commit, "--", *paths).splitlines():
    sha, day, trailers = line.split("\x1f")
    entries += [(sha, day, change) for change in trailers.split("\x1e") if change]
for line in open(f"{build}/App/Settings/changelog.tsv", encoding="utf-8"):
    sha, change = line.rstrip("\n").split("\t", 1)
    entries.append((sha, git("log", "-1", "--format=%cs", sha).strip(), change))
rows = [{"build": int(git("rev-list", "--count", sha)), "date": day, "change": change} for sha, day, change in entries]
rows = sorted(rows, key=lambda row: row["build"], reverse=True)[:60]
path = f"{build}/Config/xtool/iikb-Info.plist"
info = plistlib.load(open(path, "rb"))
info["IIKBChangelog"] = rows
plistlib.dump(info, open(path, "wb"))
PY
backup=$main/Packages/KeyboardModules/Sources/KeyboardStore/Resources/Keys/backup.key
why="backupkey the server that builds iikb has no backup key, so the build couldn't back up your data"
[ -f "$backup" ] || { echo "$backup is missing, so this build wouldn't back up the iPhone's iikb data (docs/backup.md)" >&2; exit 1; }
for key in "$main"/Packages/KeyboardModules/Sources/*/Resources/Keys/*.key; do
  to=$build/${key#"$main"/}
  [ ! -d "${to%/*}" ] || cp "$key" "$to"
done
cd "$build"
why="build build $number didn't compile or sign here (xtool)"
TURN=phone xtool dev build -c release --sign < /dev/null
why="sdk build $number was linked against an iOS SDK below 27.1"
for binary in xtool/iikb.app/iikb xtool/iikb.app/PlugIns/Keyboard.appex/Keyboard xtool/iikb.app/PlugIns/Controls.appex/Controls; do
  sdk=$(llvm-otool -l "$binary" | awk '/LC_BUILD_VERSION/ {b=1} b && $1 == "sdk" {print $2; exit}')
  [ "$(printf '%s\n27.1\n' "$sdk" | sort -V | head -1)" = 27.1 ] || {
    echo "$binary is linked against iOS SDK $sdk; below 27.1 the iPhone Duo runs iikb as an old iPhone app (AGENTS.md, scripts/phone)" >&2
    exit 1
  }
done
why="resign the Mac couldn't sign build $number"
until ssh -o ConnectTimeout=20 mac true 2>/dev/null; do
  block mac "the MacBook isn't answering, and every build is signed there"
  echo "waiting for the Mac to answer" >&2
  sleep 60
done
rsync -a --delete xtool/iikb.app/ mac:Developer/iikb-phone/iikb.app/
serial=$(python3 -c "
import glob, os, plistlib, subprocess
path = max(glob.glob(os.path.expanduser('~/.config/xtool/data/??????????')), key=os.path.getmtime)
der = plistlib.load(open(path, 'rb'))['certificate']
print(subprocess.run(['openssl', 'x509', '-inform', 'DER', '-noout', '-serial'], input=der, capture_output=True).stdout.decode().split('=')[1].strip())")
ssh mac sh -s "$serial" < scripts/resign
why="offer build $number couldn't be put on the install link"
ssh mac 'cd Developer/iikb-phone && rm -rf Payload iikb.ipa && mkdir Payload && cp -R iikb.app Payload/ && ditto -c -k --keepParent Payload iikb.ipa && rm -rf Payload'
mkdir -p "$page"
scp -q mac:Developer/iikb-phone/iikb.ipa "$page/iikb-$number.ipa"
python3 - "$page" "$url" "$number" Config/xtool/iikb-Info.plist <<'PY'
import html, plistlib, sys, urllib.parse
page, url, number, info = sys.argv[1:]
plistlib.dump({"items": [{
    "assets": [{"kind": "software-package", "url": f"{url}/iikb-{number}.ipa"}],
    "metadata": {"bundle-identifier": "com.shahidy.iikb", "bundle-version": number, "kind": "software", "title": "iikb"},
}]}, open(f"{page}/manifest.plist", "wb"))
install = html.escape("itms-services://?action=download-manifest&url=" + urllib.parse.quote(f"{url}/manifest.plist", safe=""))
changes = "".join(
    f"<li><span>{row['build']}</span>{html.escape(row['change'])}</li>"
    for row in plistlib.load(open(info, "rb"))["IIKBChangelog"][:8]
)
open(f"{page}/index.html", "w").write(f"""<!doctype html>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>iikb {number}</title>
<style>
body {{ font: 17px/1.4 -apple-system, system-ui; max-width: 30em; margin: 18vh auto 0; padding: 0 20px }}
a {{ display: block; padding: 14px; border-radius: 14px; background: #0a84ff; color: white; text-align: center; font-weight: 600; text-decoration: none }}
ul {{ list-style: none; padding: 0; margin-top: 28px; opacity: .75; font-size: 15px }}
li {{ display: grid; grid-template-columns: 3em 1fr; margin: 8px 0 }} span {{ opacity: .6 }}
</style>
<a href="{install}">Install iikb {number}</a>
<ul>{changes}</ul>
""")
PY
find "$page" -name 'iikb-*.ipa' ! -name "iikb-$number.ipa" -delete
echo "$number $(git rev-parse "$commit")" > "$stamp"
why=
echo "build $number (main $commit) is on the install link, $url/: tap Install there in Safari on the iPhone or iPad"
unblock "build $number is on the link"
on_devices
