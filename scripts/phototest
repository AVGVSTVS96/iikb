#!/bin/bash
# Runs on the Mac. Photos in Chats through the real keyboard, every flow (UITests/ChatPhotoTests.swift), light and dark,
# with scripts/chats.ts standing in for the extension: scripts/phototest ["iPhone Duo"] [iPhone-Duo]. SCREEN picks one of
# the Duo's screens in scripts/sim (folded-portrait otherwise); ORIENTATION=landscape turns any other device. LIBRARY=<n>
# puts n photos in the library (24 otherwise). Each appearance starts with the library's access reset for the Allow
# Photos test, then grants it for the rest; ONLY_ALLOW=1 runs just that test. Shots go to shots/raw/photos/, taken here
# of the screen in use when the test asks, with the keyboard's largest footprint while each appearance ran.
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone Duo}
TYPE=${2:-iPhone-Duo}
PORT=${PORT:-2597}
export SIM_PHOTOS=1
ID=$(scripts/sim ensure "$NAME" "$TYPE")
screen=${SCREEN:-folded-portrait} hinge= turn= display=
case "$TYPE" in
  *Duo*) read -r _ hinge turn display < <(grep "^$screen " <<<"$(sed -n '/^DUO_SCREENS="/,/"$/p' scripts/sim | tr -d '"' | sed 's/^DUO_SCREENS=//')") || true
    [ -n "$display" ] || { echo "no Duo screen $screen" >&2; exit 2; }
    slug=iphone-duo-$screen ;;
  *) slug=$(echo "$NAME" | tr 'A-Z ' 'a-z-')-${ORIENTATION:-portrait} ;;
esac
out=shots/raw/photos
mkdir -p "$out" build/uitest build/photos
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
  -derivedDataPath build/uitest -quiet
scripts/sim boot "$ID"
scripts/sim use "$ID" iikb
scripts/sim allow "$ID" paste
# After allow, which restarts the simulator to take Full Access, folding the Duo.
if [ -n "$hinge" ]; then
  scripts/sim unfold "$ID" 0
  [ "$hinge" = 0 ] || scripts/sim unfold "$ID" "$hinge"
  scripts/sim hub "$ID" orientation "$turn"
fi
xcrun simctl install "$ID" build/uitest/Build/Products/Debug-iphonesimulator/iikb.app

pictures=()
while IFS= read -r picture; do pictures+=("$picture"); done < <(
  find "/System/Library/Desktop Pictures" -name '*.heic' -not -path '*/.thumbnails/*' 2>/dev/null | head -6)
[ ${#pictures[@]} -gt 0 ] || { echo "no pictures to fill the library with" >&2; exit 1; }
rm -rf build/photos/*
n=0
while [ "$n" -lt "${LIBRARY:-24}" ]; do
  for picture in "${pictures[@]}"; do
    [ "$n" -lt "${LIBRARY:-24}" ] || break
    sips -s format jpeg -Z $((1200 + n % 900)) "$picture" --out "build/photos/photo-$n.jpg" >/dev/null
    n=$((n + 1))
  done
done
find build/photos -name '*.jpg' -print0 | xargs -0 -n 50 xcrun simctl addmedia "$ID"

# run <appearance> <no access: 1 or ""> <xcodebuild's test options…>
run() {
  local appearance=$1 none=$2
  shift 2
  TEST_RUNNER_IIKB_EXTENSION="http://localhost:$PORT" TEST_RUNNER_IIKB_SHOTS="$PWD/$out/$slug-$appearance" \
    TEST_RUNNER_IIKB_ORIENTATION="${ORIENTATION:-}" TEST_RUNNER_IIKB_LIBRARY="${LIBRARY:-}" TEST_RUNNER_IIKB_NO_ACCESS="$none" \
    TEST_RUNNER_IIKB_LAUNCH="$([ "${turn:-portrait}" = portrait ] && echo portrait || echo landscape)" \
    xcodebuild test-without-building -collect-test-diagnostics never -test-timeouts-enabled YES \
    -default-test-execution-time-allowance 300 -maximum-test-execution-time-allowance 420 -project iikb.xcodeproj -scheme iikb \
    -destination "id=$ID" -derivedDataPath build/uitest "$@" >> "build/uitest/photos-$appearance.log" 2>&1 || failed=1
  grep -E "error:|Test Case .*(passed|failed|skipped)" "build/uitest/photos-$appearance.log" || true
}

# The keyboard's largest physical footprint while a run goes, the measure iOS ends a keyboard by, from vmmap on its
# process on this Mac.
watch() {
  local most=0 now
  while :; do
    for pid in $(pgrep -f 'Keyboard.appex/Keyboard'); do
      now=$(vmmap --summary "$pid" 2>/dev/null | awk '/^Physical footprint:/ {
        v = $3; u = substr(v, length(v)); v = v + 0; print int(u == "G" ? v * 1024 : u == "K" ? v / 1024 : v) }')
      [ -n "$now" ] && [ "$now" -gt "$most" ] && { most=$now; echo "$most MB" > "$1"; }
    done
    sleep 1
  done
}

# Screenshots the screen in use for each <shot>.want the test leaves, then takes the request away: the screen's display
# from scripts/sim, or the first other one that isn't all one color when that one is.
shooter() {
  local want png shown
  while :; do
    for want in "$out"/*.want; do
      [ -e "$want" ] || continue
      png=${want%.want}.png
      for shown in $display 1 2 3 4; do
        xcrun simctl io "$ID" screenshot --display="$shown" "$png" >/dev/null 2>&1 || continue
        scripts/sim blank "$png" || break
      done
      [ "$shown" = "${display:-1}" ] || echo "${png##*/} is display $shown, not ${display:-1}" >&2
      rm -f "$want"
    done
    sleep 0.3
  done
}

shooter &
shooting=$!
trap 'kill "$shooting" 2>/dev/null || true' EXIT
for appearance in ${APPEARANCES:-light dark}; do
  xcrun simctl ui "$ID" appearance "$appearance"
  HOST=:: PORT=$PORT bun scripts/chats.ts > build/uitest/chats.log 2>&1 &
  stand=$!
  watch "$out/$slug-$appearance-memory.txt" &
  watcher=$!
  rm -f "build/uitest/photos-$appearance.log"
  # iikb and its keyboard each keep the answer they first read for as long as they run, so both go before the reset.
  xcrun simctl terminate "$ID" com.shahidy.iikb 2>/dev/null || true
  pgrep -f 'Keyboard.appex/Keyboard' | xargs kill 2>/dev/null || true
  xcrun simctl privacy "$ID" reset photos com.shahidy.iikb
  run "$appearance" 1 -only-testing:AppUITests/ChatPhotoTests/testAllowPhotosAsksAndThePhotosShowBackInTheApp
  if [ -z "${ONLY_ALLOW:-}" ]; then
    xcrun simctl privacy "$ID" grant photos com.shahidy.iikb
    run "$appearance" "" -only-testing:AppUITests/ChatPhotoTests \
      -skip-testing:AppUITests/ChatPhotoTests/testAllowPhotosAsksAndThePhotosShowBackInTheApp
  fi
  kill "$watcher" "$stand" 2>/dev/null || true
  wait "$watcher" "$stand" 2>/dev/null || true
  echo "keyboard footprint, $appearance: $(cat "$out/$slug-$appearance-memory.txt" 2>/dev/null || echo unmeasured)"
done
# Crash reports from the run, which the workflow keeps with the logs.
find ~/Library/Logs/DiagnosticReports -name 'iikb*.ips' -o -name 'Keyboard*.ips' 2>/dev/null | xargs -I{} cp {} build/uitest/ 2>/dev/null || true
[ -n "${KEEP:-}" ] || xcrun simctl shutdown "$ID"
exit "${failed:-0}"
