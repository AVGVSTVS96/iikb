#!/bin/bash
# Runs a command on the Mac for what needs the iPhone it reaches (scripts/chatdevice): syncs this tree to
# ~/Developer/iikb-device, runs the command there with Xcode 27.1 inside one of the Mac's turns (`turn`), and copies the
# screenshots it takes back to shots/raw/. Simulator checks run on GitHub's Macs instead (scripts/ci).
set -euo pipefail
cd "$(dirname "$0")/.."
dir=Developer/iikb-device
scripts/sync "$dir" >/dev/null
ssh mac "rm -rf ~/$dir/shots/raw" </dev/null
status=0
printf '%s\n' "$*" | ssh mac "cd ~/$dir && export DEVELOPER_DIR=\${DEVELOPER_DIR:-/Applications/Xcode-beta.app/Contents/Developer} && ~/.local/bin/turn zsh -s" || status=$?
mkdir -p shots/raw
rsync -a "mac:$dir/shots/raw/" shots/raw/ 2>/dev/null </dev/null || true
exit "$status"
