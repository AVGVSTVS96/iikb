#!/bin/sh
# Build iikb.vercel.app (web/site, Next.js exported as static files) into web/dist, keeping web/dist/.vercel.
set -eu
cd "$(dirname "$0")/.."
bun install --frozen-lockfile
(cd web/site && bun run build)
mkdir -p web/dist
rsync -a --delete --exclude .vercel web/site/out/ web/dist/
cp brand/logo/out/wordmark-paper.svg web/dist/
