#!/usr/bin/env ruby
# usage: scripts/testflight-publish BUILD_NUMBER [what-to-test]
# Waits for App Store Connect to process an uploaded build, gives it its What to Test note, adds it to the Public beta
# group (the one behind TestFlight's public link) and sends it to beta review, which approves a build of an already
# approved version in minutes. Signs in with the API key scripts/testflight uploads with.
require 'openssl'; require 'json'; require 'net/http'; require 'base64'

ENV_FILE = File.read(File.expand_path('~/.appstoreconnect/env')).scan(/(\w+)=(\S+)/).to_h
KEY = OpenSSL::PKey::EC.new(File.read(File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV_FILE['ASC_KEY_ID']}.p8")))

def jwt
  b64 = ->(s) { Base64.urlsafe_encode64(s, padding: false) }
  head = b64.(JSON.dump(alg: 'ES256', kid: ENV_FILE['ASC_KEY_ID'], typ: 'JWT'))
  body = b64.(JSON.dump(iss: ENV_FILE['ASC_ISSUER_ID'], iat: Time.now.to_i, exp: Time.now.to_i + 1100, aud: 'appstoreconnect-v1'))
  der = KEY.sign(OpenSSL::Digest::SHA256.new, "#{head}.#{body}")
  sig = OpenSSL::ASN1.decode(der).value.map { |i| i.value.to_s(2).rjust(32, "\0") }.join
  "#{head}.#{body}.#{b64.(sig)}"
end

def asc(method, path, body = nil)
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  req = Net::HTTP.const_get(method.capitalize).new(uri)
  req['Authorization'] = "Bearer #{jwt}"
  req['Content-Type'] = 'application/json'
  req.body = JSON.dump(data: body) if body
  res = Net::HTTP.start(uri.host, 443, use_ssl: true) { |http| http.request(req) }
  abort "#{method.upcase} #{path}: #{res.code} #{res.body}" unless res.is_a?(Net::HTTPSuccess)
  res.body.to_s.empty? ? {} : JSON.parse(res.body)
end

version, notes = ARGV
abort 'usage: scripts/testflight-publish BUILD_NUMBER [what-to-test]' unless version
app = asc(:get, '/v1/apps?filter[bundleId]=com.shahidy.iikb')['data'].first['id']

build = nil
120.times do
  build = asc(:get, "/v1/builds?filter[app]=#{app}&filter[version]=#{version}")['data'].first
  state = build&.dig('attributes', 'processingState')
  break if state == 'VALID'
  abort "build #{version} is #{state}" if %w[FAILED INVALID].include?(state)
  sleep 30
end
abort "build #{version} didn't finish processing in an hour" unless build&.dig('attributes', 'processingState') == 'VALID'
id = build['id']
puts "build #{version} processed (#{id})"

if notes && !notes.empty?
  localization = asc(:get, "/v1/builds/#{id}/betaBuildLocalizations")['data'].find { |l| l['attributes']['locale'] == 'en-US' }
  if localization
    asc(:patch, "/v1/betaBuildLocalizations/#{localization['id']}",
        { type: 'betaBuildLocalizations', id: localization['id'], attributes: { whatsNew: notes[0, 4000] } })
  else
    asc(:post, '/v1/betaBuildLocalizations',
        { type: 'betaBuildLocalizations', attributes: { locale: 'en-US', whatsNew: notes[0, 4000] },
          relationships: { build: { data: { type: 'builds', id: id } } } })
  end
end

group = asc(:get, "/v1/apps/#{app}/betaGroups?filter[name]=Public")['data'].first['id']
asc(:post, "/v1/betaGroups/#{group}/relationships/builds", [{ type: 'builds', id: id }])
asc(:post, '/v1/betaAppReviewSubmissions',
    { type: 'betaAppReviewSubmissions', relationships: { build: { data: { type: 'builds', id: id } } } })
puts "build #{version} is in the Public group and sent to beta review"
