#!/bin/sh
# KeyboardCore compiled to WebAssembly with the demo's scripts (web/demo) into web/.build/demo. No page loads the demo
# since iikb.vercel.app moved to Next.js (scripts/site builds it into web/dist), so this is what shows KeyboardCore still
# compiles to WebAssembly.
# Needs the swift.org Swift 6.4.0 toolchain (not Xcode's), its Wasm SDK, and binaryen's wasm-opt.
set -e
cd "$(dirname "$0")/../web"
export TOOLCHAINS="${TOOLCHAINS:-swift}"
dist=.build/demo
rm -rf "$dist"
swift package --swift-sdk swift-6.4.0-RELEASE_wasm js -c release --use-cdn
mkdir "$dist"
cp -R .build/plugins/PackageToJS/outputs/Package "$dist/engine"
cp -R demo/. "$dist/"
cp ../copy/facts.json "$dist/"
cp ../Packages/KeyboardModules/Sources/KeyboardEnglish/Resources/en.lexicon ../Packages/KeyboardModules/Sources/KeyboardEnglish/Resources/LEXICON-LICENSE "$dist/"
