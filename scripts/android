#!/bin/bash
# iikb for Android (android/AGENTS.md): the signed release APK, built here. --emulator also installs it on the Mac's
# Android emulator, booting it headless if it isn't up, and makes iikb the keyboard there.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
export JAVA_HOME=${JAVA_HOME:-/usr/lib/jvm/java-25-openjdk} ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk}
cd "$root/android"
./gradlew :app:assembleRelease --console=plain -q
apk=$root/android/app/build/outputs/apk/release/app-release.apk
echo "$apk"
[ "${1:-}" = --emulator ] || exit 0

ssh mac 'bash -s' < "$root/scripts/android-emulator"
scp -q "$apk" mac:/tmp/iikb.apk
ssh mac 'adb=~/Library/Android/sdk/platform-tools/adb; $adb install -r /tmp/iikb.apk >/dev/null && rm /tmp/iikb.apk &&
    $adb shell ime enable com.shahidy.iikb/.keyboard.IikbService >/dev/null &&
    $adb shell ime set com.shahidy.iikb/.keyboard.IikbService >/dev/null && echo installed on the emulator'
