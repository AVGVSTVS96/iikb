#!/bin/bash
# iikb for Android (android/AGENTS.md): the signed release APK, built here. --emulator also installs it on the Mac's
# Android emulator, booting it headless if it isn't up, and makes iikb the keyboard there; a script after it runs on the
# Mac right after the install. Agents share the one emulator, so the install and that script hold its lock together,
# and no other build lands mid-test. The one holding the lock is the one testing, so its build goes on even over a newer
# one from another agent's unpushed commits.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
export JAVA_HOME=${JAVA_HOME:-/usr/lib/jvm/java-25-openjdk} ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk}
# The API keys are out of git, so a worktree has none of its own: it takes the main checkout's, and its builds keep GIFs.
keys=Packages/KeyboardModules/Sources/FullKeyboard/Resources/Keys
main=$(dirname "$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)")
for key in "$main/$keys"/*.key; do
  if [ -e "$key" ] && [ ! -e "$root/$keys/${key##*/}" ]; then cp "$key" "$root/$keys/"; fi
done
cd "$root/android"
./gradlew :app:assembleRelease --console=plain -q
apk=$root/android/app/build/outputs/apk/release/app-release.apk
echo "$apk"
[ "${1:-}" = --emulator ] || exit 0

ssh mac 'bash -s' < "$root/scripts/android-emulator"
run=$(ssh mac 'mktemp -d /tmp/iikb-run.XXXXXX')
scp -q "$apk" "mac:$run/iikb.apk"
if [ -n "${2:-}" ]; then scp -q "$2" "mac:$run/drive.sh"; fi
ssh mac "lockf -k /tmp/iikb-emulator.lock bash -c '
    export ANDROID_SERIAL=emulator-5554
    adb=~/Library/Android/sdk/platform-tools/adb
    \$adb install -r -d $run/iikb.apk >/dev/null || exit 1
    for _ in 1 2 3; do \$adb shell ime enable com.shahidy.iikb/.keyboard.IikbService >/dev/null && break; sleep 1; done
    \$adb shell ime set com.shahidy.iikb/.keyboard.IikbService >/dev/null
    echo installed on the emulator
    [ ! -f $run/drive.sh ] || bash $run/drive.sh
'; rm -rf $run"
