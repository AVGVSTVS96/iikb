#!/bin/bash
# Runs on GitHub's Macs (scripts/ci). Headless simulator helpers for screenshots and keyboard checks.
set -euo pipefail
[ -n "${GITHUB_ACTIONS:-}" ] || { echo "simulators run on GitHub's Macs: scripts/ci '<command>'" >&2; exit 1; }
# A run leaves its simulator booted for the next command in the job; KEEP= shuts it down.
KEEP=${KEEP-1}
cd "$(dirname "$0")/.."

APP=${APP:-build/Build/Products/Debug-iphonesimulator/iikb.app}
BUNDLE=com.shahidy.iikb
# The iPhone Duo's screens, as Bassim names them: name, hinge angle, Device Hub orientation, display. Slightly folded is
# the small fold his reports are about.
DUO_SCREENS="folded-portrait 0 portrait 1
folded-landscape 0 landscape-right 1
open-landscape 180 portrait 3
open-portrait 180 landscape-right 3
open-landscape-slightly-folded 160 portrait 3
open-portrait-slightly-folded 160 landscape-right 3"
PREFIX=${SIMPREFIX:-iikb}

# A simulator's id by name, in RUNTIME if set.
udid() {
  xcrun simctl list devices -j | /usr/bin/python3 -c "
import json, sys
name, runtime = sys.argv[1], sys.argv[2]
for r, ds in json.load(sys.stdin)['devices'].items():
    for d in ds:
        if d['name'] == name and d['isAvailable'] and runtime in ('', r): print(d['udid']); sys.exit()" "$1" "${RUNTIME:-}"
}

# The one simulator of a device type (named for the type, whatever name the caller gives), made on RUNTIME or else the
# newest iOS that has the type, with the others shut down.
ensure() {
  local name="$PREFIX ${2//-/ }" type="com.apple.CoreSimulator.SimDeviceType.$2" id runtime
  id=$(udid "$name")
  if [ -z "$id" ]; then
    runtime=${RUNTIME:-$(xcrun simctl list runtimes -j | /usr/bin/python3 -c "
import json, sys
print([r['identifier'] for r in json.load(sys.stdin)['runtimes'] if r['platform'] == 'iOS' and r['isAvailable']
       and any(d['identifier'] == sys.argv[1] for d in r['supportedDeviceTypes'])][-1])" "$type")}
    id=$(xcrun simctl create "$name" "$type" "$runtime")
  fi
  for other in $(xcrun simctl list devices booted | sed -n "s/^ *$PREFIX .*(\([0-9A-F-]\{36\}\)) (Booted).*/\1/p"); do
    [ "$other" = "$id" ] || down "$other"
  done
  echo "$id"
}

# Shuts a simulator down; one already down is fine.
down() {
  xcrun simctl shutdown "$1" 2>/dev/null || ! xcrun simctl list devices booted | grep -q "$1"
}

# Boots a simulator and installs iikb, built first when a file it's built from is newer than the build, as after a sync,
# so a shot never shows an older iikb; a build a command made itself (APP set) it refuses when older.
# A simulator boots slim (simslim: without the ~170 iOS services no check uses, a third of the memory and CPU), keeping
# the widget and App Intents services Control Center's controls need when SIM_WIDGETS is set, and the photo library's
# when SIM_PHOTOS is set.
boot() {
  xcrun simctl list devices booted | grep -q "$1" || ! command -v simslim >/dev/null ||
    simslim on "$1" ${SIM_WIDGETS:+--keep com.apple.chronod,com.apple.siriactionsd} \
      ${SIM_PHOTOS:+--except photos} >/dev/null
  perl -e 'alarm shift; exec @ARGV' 1800 xcrun simctl bootstatus "$1" -b >/dev/null
  xcrun simctl spawn "$1" defaults write com.apple.keyboard.preferences DidShowContinuousPathIntroduction -bool true
  [ -z "${IIKB_NOW:-}" ] || stop "$1"
  if [ ! -e "$APP" ] || [ -n "$(find App Packages Keyboard Controls project.yml -newer "$APP" -print -quit)" ]; then
    [ "$APP" = build/Build/Products/Debug-iphonesimulator/iikb.app ] || { echo "$APP is older than the tree it would show; build it first" >&2; exit 1; }
    scripts/build >&2 && touch "$APP"
  fi
  xcrun simctl install "$1" "$APP"
}

# Stops the clock at IIKB_NOW for screens that never move between runs (scripts/screens): the wall clock in iikb's app
# and keyboard (scripts/clock.c), for every process the simulator starts from here until it shuts down, with Swift's
# hashing seeded the same in each, so a dictionary's order (as among ties) holds from launch to launch, and the status
# bar's at 9:41.
stop() {
  local clock=$PWD/build/clock.dylib
  [ "$clock" -nt scripts/clock.c ] || { mkdir -p build && xcrun -sdk iphonesimulator clang -arch arm64 \
    -mios-simulator-version-min=27.0 -O2 -dynamiclib -o "$clock" scripts/clock.c -framework CoreFoundation &&
    codesign -f -s - "$clock" 2>/dev/null; }
  xcrun simctl spawn "$1" launchctl setenv IIKB_NOW "$IIKB_NOW"
  xcrun simctl spawn "$1" launchctl setenv DYLD_INSERT_LIBRARIES "$clock"
  xcrun simctl spawn "$1" launchctl setenv SWIFT_DETERMINISTIC_HASHING 1
  xcrun simctl status_bar "$1" override --time 9:41 --dataNetwork wifi --wifiMode active --wifiBars 3 \
    --cellularMode notSupported --batteryState charged --batteryLevel 100
}

# Turns on Full Access (with paste, Paste from Other Apps too), which iOS keeps in TCC's database, written where Settings
# writes it; a simulator without them restarts to take them.
allow() {
  local db=~/Library/Developer/CoreSimulator/Devices/$1/data/Library/TCC/TCC.db
  local rows="('kTCCServiceKeyboardNetwork', '$BUNDLE'), ('kTCCServiceKeyboardNetwork', '$BUNDLE.keyboard')"
  [ "${2:-}" = paste ] && rows="$rows, ('kTCCServicePasteboard', '$BUNDLE')"
  perl -e 'alarm shift; exec @ARGV' 1800 xcrun simctl bootstatus "$1" -b >/dev/null
  [ "$(sqlite3 "$db" "select count(*) = $(grep -o '(' <<<"$rows" | wc -l) from access where auth_value = 2 and (service, client) in (values $rows)")" = 1 ] && return
  down "$1"
  sqlite3 "$db" "insert or replace into access (service, client, client_type, auth_value, auth_reason, auth_version, flags)
    select column1, column2, 0, 2, 4, 1, 0 from (values $rows)"
  boot "$1"
}

use() {
  local id=$1 keyboards
  case $2 in
    iikb) keyboards=("com.shahidy.iikb.keyboard" "en_US@sw=QWERTY;hw=Automatic") ;;
    system) keyboards=("en_US@sw=QWERTY;hw=Automatic") ;;
    system:*) keyboards=("${2#system:};hw=Automatic") ;;
  esac
  local current expanded
  current=$(xcrun simctl spawn "$id" defaults read .GlobalPreferences AppleKeyboards 2>/dev/null | sed '1d;$d' | tr -d ' ",\n' || true)
  expanded=$(xcrun simctl spawn "$id" defaults read .GlobalPreferences AppleKeyboardsExpanded 2>/dev/null || true)
  [ "$current" = "$(printf %s "${keyboards[@]}")" ] && [ "$expanded" = 1 ] && return
  xcrun simctl spawn "$id" defaults write .GlobalPreferences AppleKeyboards -array "${keyboards[@]}"
  xcrun simctl spawn "$id" defaults write .GlobalPreferences AppleKeyboardsExpanded -int 1
  down "$id"
  boot "$id"
}

# A screenshot of the simulator's screen (DISPLAY_ID picks the Duo's), taken once the app has drawn and stopped moving:
# a launch can take far longer than usual on GitHub's Macs, and a fixed wait shot those launches blank. Shoots again
# each second until two shots match and the screen below the status bar isn't one color, up to SETTLE seconds (30);
# fails, leaving no shot, if it's still blank by then.
screenshot() {
  local id=$1 out=$2 last="$2.last.png" next="$2.next.png" waited=0 drawn
  mkdir -p "$(dirname "$out")"
  rm -f "$last"
  while sleep 1; do
    waited=$((waited + 1))
    xcrun simctl io "$id" screenshot ${DISPLAY_ID:+--display="$DISPLAY_ID"} "$next" >/dev/null 2>&1 || continue
    drawn=
    blank "$next" || drawn=1
    if [ -n "$drawn" ] && [ -e "$last" ] && cmp -s "$next" "$last"; then break; fi
    mv "$next" "$last"
    [ "$waited" -lt "${SETTLE:-30}" ] && continue
    [ -n "$drawn" ] && break
    rm -f "$last"
    echo "blank after ${waited}s: $out" >&2
    return 1
  done
  [ -e "$next" ] && mv "$next" "$out" || mv "$last" "$out"
  rm -f "$last" "$next"
}

# Whether a screenshot is one color below its status bar, as a page that hasn't drawn yet is.
blank() {
  local bmp="$1.bmp"
  sips -s format bmp "$1" --out "$bmp" >/dev/null 2>&1
  /usr/bin/python3 - "$bmp" <<'PY'
import struct, sys
data = open(sys.argv[1], "rb").read()
offset, = struct.unpack_from("<I", data, 10)
width, height = struct.unpack_from("<ii", data, 18)
bits, = struct.unpack_from("<H", data, 28)
size = bits // 8
stride = (width * size + 3) // 4 * 4
rows = [data[offset + r * stride:offset + r * stride + width * size] for r in range(abs(height))]
if height > 0:
    rows.reverse()
below = rows[len(rows) * 8 // 100:]
first = below[0][:size]
sys.exit(0 if all(row == first * width for row in below) else 1)
PY
  local result=$?
  rm -f "$bmp"
  return "$result"
}

shoot() {
  local id=$1 keyboard=$2 appearance=$3 out=$4; shift 4
  xcrun simctl ui "$id" appearance "$appearance"
  xcrun simctl terminate "$id" "$BUNDLE" 2>/dev/null || true
  use "$id" "$keyboard"
  local attempt orientation=(-iikbOrientation portrait)
  [[ " $* " == *iikbOrientation* ]] && orientation=()
  for attempt in 1 2 3 4 5; do
    xcrun simctl launch "$id" "$BUNDLE" -iikbFocus YES ${orientation[@]+"${orientation[@]}"} "$@" >/dev/null 2>&1 && break
    [ "$attempt" = 3 ] && xcrun simctl install "$id" "$APP"
    sleep 2
  done
  screenshot "$id" "$out"
}

DEVICES=("iPhone 17:iPhone-17" "iPhone 17 Pro Max:iPhone-17-Pro-Max" "iPhone 16e:iPhone-16e" "iPhone Air:iPhone-Air"
  "iPad Pro 11:iPad-Pro-11-inch-M4-8GB" "iPad Pro 13:iPad-Pro-13-inch-M4-8GB" "iPad A16:iPad-A16" "iPad mini:iPad-mini-A17-Pro"
  "iPhone Duo:iPhone-Duo")

all() {
  local tag=$1; shift
  for spec in "${DEVICES[@]:0:8}"; do
    local name=${spec%%:*} id slug
    [ -n "${ONLY:-}" ] && [[ "$name" != *$ONLY* ]] && continue
    slug=$(echo "$name" | tr 'A-Z ' 'a-z-')
    id=$(ensure "$name" "${spec##*:}")
    boot "$id"
    for keyboard in ${KEYBOARDS:-system iikb}; do
      for appearance in light dark; do
        shoot "$id" "$keyboard" "$appearance" "shots/raw/$slug-$tag-$keyboard-$appearance.png" "$@"
      done
    done
    [ -n "${KEEP:-}" ] || down "$id"
  done
}

variants() {
  local name=$1 tag=$2 id slug spec
  for spec in "${DEVICES[@]}"; do [ "${spec%%:*}" = "$name" ] && id=$(ensure "$name" "${spec##*:}"); done
  slug=$(echo "$name" | tr 'A-Z ' 'a-z-')
  boot "$id"
  for keyboard in ${KEYBOARDS:-system iikb}; do
    while read -r variant args; do
      shoot "$id" "$keyboard" "${APPEARANCE:-light}" "shots/raw/$slug-$tag-$variant-$keyboard.png" $args
    done <<VARIANTS
return-go -iikbReturnKey 1
return-search -iikbReturnKey 6
return-send -iikbReturnKey 7
return-done -iikbReturnKey 9
return-next -iikbReturnKey 4
type-email -FullKeyboardType 7
type-url -FullKeyboardType 3
type-numbers -FullKeyboardType 2
type-websearch -FullKeyboardType 10
landscape -iikbOrientation landscape
VARIANTS
  done
  [ -n "${KEEP:-}" ] || down "$id"
}

# Sends Device Hub's events to a booted iPhone Duo (scripts/devicehub.c): hub ID hinge 180, hub ID orientation portrait.
hub() {
  local helper=build/devicehub
  [ "$helper" -nt scripts/devicehub.c ] || { xcrun -sdk iphonesimulator clang -arch arm64 -mios-simulator-version-min=27.0 -O2 \
    -o "$helper" scripts/devicehub.c -framework IOKit -framework CoreFoundation && codesign -f -s - "$helper" 2>/dev/null; }
  xcrun simctl spawn "$1" "$PWD/$helper" "${@:2}"
}

# Opens a booted iPhone Duo, or folds it with 0. Each screen sets its own fold, since a run leaves its simulator booted as the last one left it.
unfold() {
  hub "$1" hinge "${2:-180}"
  sleep 3
}

# Screenshots each keyboard on the iPhone Duo's four screens (folded and open, portrait and landscape, as Bassim names
# them) and the open ones slightly folded, in the iOS 27.1 simulator, the only one with the Duo:
# shots/raw/duo/<tag>-<screen>-<keyboard>-<appearance>.png. The open screen comes from unfolding the simulator
# (scripts/devicehub.c); a reboot folds it again. The open screen's own upright is landscape, 951 wide, so Device Hub's
# portrait shows it in landscape. SCREENS (folded-portrait open-landscape …) picks some. LISTENING=1 shows the bar while you talk, saved or waiting with dictations saved (scripts/voiceapp.py); DUO names the simulator.
duo() {
  local tag=$1 id app=; shift
  id=$(ensure "${DUO:-iPhone Duo}" iPhone-Duo)
  for keyboard in ${KEYBOARDS:-system iikb}; do
    boot "$id"
    unfold "$id" 0
    [ -z "${LISTENING:-}" ] || allow "$id"
    if [ -n "${LISTENING:-}" ] && [ "$keyboard" = iikb ]; then
      /usr/bin/python3 scripts/voiceapp.py "$id" "$(xcrun simctl get_app_container "$id" "$BUNDLE" group.com.shahidy.iikb)" "$([ "$LISTENING" = 1 ] && echo listening || echo "$LISTENING")" &
      app=$!
    fi
    while read -r screen hinge orientation display; do
      [ -n "${SCREENS:-}" ] && [[ " $SCREENS " != *" $screen "* ]] && continue
      unfold "$id" "$hinge"
      hub "$id" orientation "$orientation"
      for appearance in ${APPEARANCES:-light dark}; do
        DISPLAY_ID=$display shoot "$id" "$keyboard" "$appearance" "shots/raw/duo/$tag-$screen-$keyboard-$appearance.png" \
          -iikbOrientation "$([ "$orientation" = portrait ] && echo portrait || echo landscape)" "$@"
      done
    done <<<"$DUO_SCREENS"
    [ -z "$app" ] || { kill "$app"; wait "$app" 2>/dev/null || true; app=; }
  done
  [ -n "${KEEP:-}" ] || down "$id"
}

# Screenshots the keyboard in every theme on the iPhone Duo, folded and open, light and dark:
# shots/raw/themes/<tag>-<theme>-<screen>-<appearance>.png. THEMES and SCREENS (folded-portrait folded-landscape
# open-landscape open-portrait) pick some; extra arguments go to the app (-iikbReturnKey 1).
themes() {
  local tag=$1 id; shift
  id=$(ensure "iPhone Duo" iPhone-Duo)
  boot "$id"
  unfold "$id" 0
  while read -r screen hinge orientation display; do
    [ -n "${SCREENS:-}" ] && [[ " $SCREENS " != *" $screen "* ]] && continue
    unfold "$id" "$hinge"
    hub "$id" orientation "$orientation"
    for theme in ${THEMES:-standard clear physical physical-dark physical-light mechanical mechanical-dark mechanical-light classic}; do
      local name=${theme%%-*} look=automatic
      [ "$name" != "$theme" ] && look=${theme#*-}
      for appearance in ${APPEARANCES:-dark light}; do
        DISPLAY_ID=$display shoot "$id" iikb "$appearance" "shots/raw/themes/$tag-$theme-$screen-$appearance.png" \
          -iikbOrientation "$([ "$orientation" = portrait ] && echo portrait || echo landscape)" -iikbTheme "$name" -iikbThemeAppearance "$look" "$@"
      done
    done
  done <<<"$DUO_SCREENS"
  [ -n "${KEEP:-}" ] || down "$id"
}

# The app's pages as duoapp and ipadapp screenshot them: a name and the launch arguments that open it.
APP_PAGES="home -iikbTab home
typing -iikbFocus YES
settings -iikbSettings YES
appearance -iikbSettings appearance
typing-settings -iikbSettings typing
feedback -iikbSettings feedback
voice -iikbSettings voice
writing -iikbSettings writing
dictionary -iikbSettings dictionary
extensions -iikbSettings extensions
transcripts -iikbTab transcripts
transcript -iikbTab transcripts -iikbTranscript YES
clipboard -iikbTab clipboard
overview -iikbStats overview
overview-mac -iikbStats overview -iikbStatsComputer Mac
stats -iikbStats typing
stats-dictation -iikbStats dictation
stats-mac -iikbStats typing -iikbStatsComputer Mac
stats-mac-dictation -iikbStats dictation -iikbStatsComputer Mac
add-computer -iikbStats typing -iikbAddComputer YES
taps -iikbTaps YES
taps-aim -iikbTaps YES -iikbTapsMode aim -iikbTapsKey e
sources -iikbSettings sources
access -iikbSettings access
privacy -iikbSettings privacy
changelog -iikbSettings changelog
about -iikbSettings about"

# Fills an installed app with what duoapp and ipadapp show: TOUCHES (a touch model, as the keyboard shares it), TYPING
# (JSON lines of hours, as the keyboard shares them) and TRANSCRIPTS (JSON lines, as the app keeps them, with RECORDINGS a
# folder of their <id>.wav sounds) fill Stats and Transcripts, MAC (a Keystroke typing-stats.json) Stats' Mac as the copy last read, and CLIPBOARD (a history.json, as
# ClipboardStore keeps it) Clipboard, and APPNAMES (bundle IDs to names, as AppName keeps them) the apps' names without
# asking the App Store. shots/demo/make.py writes a made-up set of each. The touch model also goes in the
# keyboard's own memory, which it shares over the group's copy each time it closes; the clipboard empties the keyboard's
# own history and the simulator's clipboard, which the keyboard and the app would add to it.
fill() {
  local id=$1 group data keyboard= meta
  group=$(xcrun simctl get_app_container "$id" "$BUNDLE" group.com.shahidy.iikb)
  data=$(xcrun simctl get_app_container "$id" "$BUNDLE" data)
  for meta in "${data%/Application/*}"/PluginKitPlugin/*/.com.apple.mobile_container_manager.metadata.plist; do
    [ "$(plutil -extract MCMMetadataIdentifier raw "$meta" 2>/dev/null)" = "$BUNDLE.keyboard" ] && keyboard=$(dirname "$meta")
  done
  [ -n "${TOUCHES:-}" ] && mkdir -p "$group/Library" && cp -p "$TOUCHES" "$group/Library/touches.json"
  [ -n "${TOUCHES:-}" ] && [ -n "$keyboard" ] && mkdir -p "$keyboard/Library/Application Support" && {
    printf '{"memory":{"counts":{},"kept":[],"following":{},"total":0,"spacesAfterSpace":0,"keysAfterSpace":0,"touches":'
    cat "$TOUCHES"
    printf '}}'
  } >"$keyboard/Library/Application Support/typing-memory.json"
  [ -n "${TYPING:-}" ] && mkdir -p "$group/Library" && cp -p "$TYPING" "$group/Library/typing.jsonl"
  [ -n "${MAC:-}" ] && mkdir -p "$data/Library/Caches/computers" "$data/Library/Application Support" && cp -p "$MAC" "$data/Library/Caches/computers/Mac.json" &&
    echo '[{"name":"Mac","url":"http://mac.local:2593","token":"t"}]' >"$data/Library/Application Support/computers.json"
  [ -n "${TRANSCRIPTS:-}" ] && mkdir -p "$data/Library/Application Support" && cp -p "$TRANSCRIPTS" "$data/Library/Application Support/transcripts.jsonl"
  [ -n "${RECORDINGS:-}" ] && mkdir -p "$data/Library/Application Support/recordings" && cp -p "$RECORDINGS"/*.wav "$data/Library/Application Support/recordings/"
  [ -n "${APPNAMES:-}" ] && mkdir -p "$data/Library/Caches" && cp -p "$APPNAMES" "$data/Library/Caches/app-names.json"
  [ -n "${CLIPBOARD:-}" ] && mkdir -p "$group/Library/clipboard" && cp -p "$CLIPBOARD" "$group/Library/clipboard/history.json" &&
    { [ -z "$keyboard" ] || rm -rf "$keyboard/Library/Application Support/clipboard"; } && xcrun simctl pbcopy "$id" </dev/null
  return 0
}

# Screenshots each of the app's screens on the iPhone Duo's four screens, as duo does for the keyboard:
# shots/raw/duo/app/<tag>-<screen>-<page>-<appearance>.png, filled as fill says; PAGES picks the pages, SCREENS the
# screens; ARGS adds launch arguments to each (-iikbScrollToEnd YES shows each page's end); SIM names the simulator.
# The keys are the default theme unless ARGS picks one, since the simulator keeps whatever an earlier command set.
duoapp() {
  local tag=$1 id; shift
  id=$(ensure "${SIM:-iPhone Duo}" iPhone-Duo)
  boot "$id"
  allow "$id" paste
  use "$id" iikb
  unfold "$id" 0
  fill "$id"
  local look="-iikbTheme standard -iikbThemeAppearance automatic"
  [[ "${ARGS:-}" == *-iikbTheme* ]] && look=
  while read -r screen hinge orientation display; do
    [ -n "${SCREENS:-}" ] && [[ " $SCREENS " != *" $screen "* ]] && continue
    unfold "$id" "$hinge"
    hub "$id" orientation "$orientation"
    for appearance in ${APPEARANCES:-dark light}; do
      xcrun simctl ui "$id" appearance "$appearance"
      while read -r page args; do
        [ -n "${PAGES:-}" ] && [[ " $PAGES " != *" $page "* ]] && continue
        xcrun simctl terminate "$id" "$BUNDLE" 2>/dev/null || true
        hub "$id" orientation "$orientation"
        xcrun simctl launch "$id" "$BUNDLE" -iikbOrientation "$([ "$orientation" = portrait ] && echo portrait || echo landscape)" $look $args ${ARGS:-} >/dev/null 2>&1 || true
        DISPLAY_ID=$display screenshot "$id" "shots/raw/duo/app/$tag-$screen-$page-$appearance.png" || failed=1
      done <<<"$APP_PAGES"
    done
  done <<<"$DUO_SCREENS"
  [ -n "${KEEP:-}" ] || down "$id"
  return "${failed:-0}"
}

# Screenshots each of the app's pages on an iPhone (PHONE, "iPhone 17" by default), upright:
# shots/raw/phone/app/<tag>-<page>-<appearance>.png, filled as fill says; PAGES, APPEARANCES and ARGS as duoapp takes them.
phoneapp() {
  local tag=$1 phone=${PHONE:-iPhone 17} id look="-iikbTheme standard -iikbThemeAppearance automatic"
  id=$(ensure "$phone" "${phone// /-}")
  boot "$id"
  allow "$id" paste
  use "$id" iikb
  fill "$id"
  [[ "${ARGS:-}" == *-iikbTheme* ]] && look=
  mkdir -p shots/raw/phone/app
  for appearance in ${APPEARANCES:-dark light}; do
    xcrun simctl ui "$id" appearance "$appearance"
    while read -r page args; do
      [ -n "${PAGES:-}" ] && [[ " $PAGES " != *" $page "* ]] && continue
      xcrun simctl terminate "$id" "$BUNDLE" 2>/dev/null || true
      xcrun simctl launch "$id" "$BUNDLE" -iikbOrientation portrait $look $args ${ARGS:-} >/dev/null 2>&1 || true
      screenshot "$id" "shots/raw/phone/app/$tag-$page-$appearance.png" || failed=1
    done <<<"$APP_PAGES"
  done
  [ -n "${KEEP:-}" ] || down "$id"
  return "${failed:-0}"
}

# iPads and the windows each gives the app: full screen upright and sideways, then windows dragged toward a size in
# points, which iPadOS snaps to the sizes it tiles windows at, so each shot's name ends in the size it got.
IPAD_WINDOWS="iPad-mini-A17-Pro portrait portrait -
iPad-mini-A17-Pro landscape landscape -
iPad-Pro-11-inch-M4-8GB portrait portrait -
iPad-Pro-11-inch-M4-8GB landscape landscape -
iPad-Pro-11-inch-M4-8GB third landscape 400x834
iPad-Pro-11-inch-M4-8GB half landscape 600x834
iPad-Pro-11-inch-M4-8GB two-thirds landscape 800x834
iPad-Pro-11-inch-M4-8GB window landscape 900x640
iPad-Pro-11-inch-M4-8GB portrait-half portrait 417x1210
iPad-Pro-13-inch-M4-8GB portrait portrait -
iPad-Pro-13-inch-M4-8GB landscape landscape -
iPad-Pro-13-inch-M4-8GB half landscape 683x1032"

# Screenshots each of the app's screens on iPads in each window of IPAD_WINDOWS, through UITests/AppShots, which turns
# the iPad and drags the window to its size as you would: shots/raw/ipad/app/<tag>-<device>-<window>-<appearance>-<page>-<size>.png,
# each its window alone; filled as fill says; IPADS, WINDOWS, PAGES and APPEARANCES pick.
ipadapp() {
  local tag=$1 device window orientation size id last= prefix
  export APP=build/uitest/Build/Products/Debug-iphonesimulator/iikb.app
  mkdir -p shots/raw/ipad/app
  while read -r device window orientation size <&3; do
    [ -n "${IPADS:-}" ] && [[ " $IPADS " != *" $device "* ]] && continue
    [ -n "${WINDOWS:-}" ] && [[ " $WINDOWS " != *" $window "* ]] && continue
    if [ "$device" != "$last" ]; then
      id=$(ensure "$device" "$device")
      [ -n "$last" ] || { xcodegen generate -q
        xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$id" -derivedDataPath build/uitest -quiet && touch "$APP"; }
      boot "$id"
      allow "$id" paste
      use "$id" iikb
      fill "$id"
      last=$device
    fi
    for appearance in ${APPEARANCES:-dark light}; do
      xcrun simctl ui "$id" appearance "$appearance"
      prefix="$PWD/shots/raw/ipad/app/$tag-$device-$window-$appearance"
      TEST_RUNNER_IIKB_SHOTS=$prefix TEST_RUNNER_IIKB_ORIENTATION=$orientation TEST_RUNNER_IIKB_WINDOW=${size#-} \
        TEST_RUNNER_IIKB_PAGES=$(while read -r page args; do
          [ -n "${PAGES:-}" ] && [[ " $PAGES " != *" $page "* ]] && continue
          echo "$page $args"
        done <<<"$APP_PAGES") \
        xcodebuild test-without-building -collect-test-diagnostics never -project iikb.xcodeproj -scheme iikb -destination "id=$id" \
        -derivedDataPath build/uitest -only-testing:AppUITests/AppShots > build/uitest/app.log 2>&1 || { failed=1; tail -20 build/uitest/app.log; }
      grep -E "error:|SHOT|Test Case .*(passed|failed)" build/uitest/app.log || true
    done
  done 3<<<"$IPAD_WINDOWS"
  [ -n "${KEEP:-}" ] || down "$id"
  return "${failed:-0}"
}

# Each language's letters and numbers, Apple's keyboard beside iikb's, light, on ON (phone duo mini pad11 pad13;
# phones and iPads upright and sideways, the Duo's four screens): shots/raw/lang/<tag>/<device>-<screen>-<name>-<layer>-<keyboard>.png.
# LANGS lines are a name, Apple's input mode and iikb's language and layout; KEYBOARDS (system iikb) and LAYERS pick.
LANGS="en-qwerty en_US@sw=QWERTY en qwerty
en-azerty en_US@sw=AZERTY en azerty
en-qwertz en_US@sw=QWERTZ en qwertz
es-spanish es_ES@sw=QWERTY-Spanish es spanish
es_MX-spanish es_MX@sw=QWERTY-Spanish es spanish
fr-french fr_FR@sw=AZERTY-French fr french
fr-azerty fr_FR@sw=AZERTY fr azerty
fr-qwerty-accents fr_FR@sw=QWERTY-Accents fr qwerty
de-german de_DE@sw=QWERTZ-German de german
de-qwertz de_DE@sw=QWERTZ de qwertz
pt_BR-qwerty pt_BR@sw=QWERTY pt qwerty
pt_PT-qwerty pt_PT@sw=QWERTY pt qwerty
it-qwerty it_IT@sw=QWERTY it qwerty
sv-swedish sv_SE@sw=QWERTY-Swedish-Finnish sv swedish"
langs() {
  local tag=$1 dev id spec keyboard name mode language layout layer screen hinge orientation display out
  mkdir -p "shots/raw/lang/$tag"
  for dev in ${ON:-phone duo mini pad11 pad13}; do
    case $dev in
      phone) spec="iPhone 17:iPhone-17" ;;
      duo) spec="iPhone Duo:iPhone-Duo" ;;
      mini) spec="iPad mini:iPad-mini-A17-Pro" ;;
      pad11) spec="iPad Pro 11:iPad-Pro-11-inch-M4-8GB" ;;
      pad13) spec="iPad Pro 13:iPad-Pro-13-inch-M4-8GB" ;;
    esac
    id=$(ensure "${spec%%:*}" "${spec##*:}")
    boot "$id"
    for keyboard in ${KEYBOARDS:-system iikb}; do
      [ "$keyboard" = iikb ] && use "$id" iikb
      while read -r name mode language layout; do
        [ -n "${ONLY:-}" ] && [[ " $ONLY " != *" $name "* ]] && continue
        [ "$keyboard" = system ] && use "$id" "system:$mode"
        if [ "$dev" = duo ]; then screens=$DUO_SCREENS; else screens="portrait 0 portrait 1
landscape 0 landscape 1"; fi
        while read -r screen hinge orientation display; do
          [[ "$screen" == *slightly* ]] && continue
          [ "$dev" = duo ] && { unfold "$id" "$hinge"; hub "$id" orientation "$orientation"; }
          for layer in ${LAYERS:-letters numbers}; do
            out="shots/raw/lang/$tag/$dev-$screen-$name-$layer-$keyboard.png"
            DISPLAY_ID=$([ "$dev" = duo ] && echo "$display") shoot "$id" "$([ "$keyboard" = system ] && echo "system:$mode" || echo iikb)" light "$out" \
              -iikbOrientation "$([ "$orientation" = portrait ] && echo portrait || echo landscape)" \
              -iikbLanguage "$language" -iikbLayout "$layout" \
              $([ "$layer" = numbers ] && echo "-FullKeyboardType 2") -iikbTheme standard -iikbThemeAppearance automatic || failed=1
          done
        done <<<"$screens"
      done <<<"$LANGS"
    done
    [ -n "${KEEP:-}" ] || down "$id"
  done
  return "${failed:-0}"
}

# Screenshots the app's Stats › Taps screen showing a touch model (JSON, as the keyboard shares it), light and dark:
# Heat, Aim and Accuracy, each alone and with KEY selected (Heat's scrolled to the key's close-up), and the
# thumbs and most-missed sections at the bottom.
taps() {
  local name=$1 type=$2 touches=$3 tag=$4 id slug group attempt
  id=$(ensure "$name" "$type")
  slug=$(echo "$name" | tr 'A-Z ' 'a-z-')
  boot "$id"
  group=$(xcrun simctl get_app_container "$id" "$BUNDLE" group.com.shahidy.iikb)
  mkdir -p "$group/Library" && cp "$touches" "$group/Library/touches.json"
  for appearance in light dark; do
    xcrun simctl ui "$id" appearance "$appearance"
    while read -r variant args; do
      xcrun simctl terminate "$id" "$BUNDLE" 2>/dev/null || true
      for attempt in 1 2 3; do
        xcrun simctl launch "$id" "$BUNDLE" -iikbTaps YES $args >/dev/null 2>&1 && break
        sleep 2
      done
      screenshot "$id" "shots/raw/$slug-$tag-taps-$variant-$appearance.png" || failed=1
    done <<VARIANTS
heat
heat-key -iikbTapsKey ${KEY:-p} -iikbTapsScroll detail
aim -iikbTapsMode aim
aim-key -iikbTapsMode aim -iikbTapsKey ${KEY:-p}
accuracy -iikbTapsMode accuracy
accuracy-key -iikbTapsMode accuracy -iikbTapsKey ${KEY:-p}
thumbs -iikbTapsScroll bottom
VARIANTS
  done
  [ -n "${KEEP:-}" ] || down "$id"
  return "${failed:-0}"
}

"$@"
