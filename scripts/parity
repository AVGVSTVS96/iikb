#!/bin/bash
# Runs on a Mac (GitHub's, through .github/workflows/shots.yml). Every screen of iikb on an iPhone (PHONE, "iPhone 17"
# by default), the phone layout the Android port is checked against, light and dark, with shots/demo's made-up data: the
# keyboard's states (UITests/ParityShots, a section a run), dictation in the bar (scripts/voiceapp.py standing in for
# the app), each of the app's pages at its top and its end (scripts/sim phoneapp), then Chats, with scripts/chats.ts
# standing in for an extension, last, since the extension it adds would show on the menu and in Settings.
# Into shots/raw/parity/<screen>-<appearance>.png, with what XCUITest saw in <screen>-<appearance>.json for the
# keyboard's. PARTS picks some of light (the keyboard's), dark, app and chats, so they can run side by side on several
# Macs (.github/workflows/screens.yml).
set -euo pipefail
cd "$(dirname "$0")/.."
export APP=build/uitest/Build/Products/Debug-iphonesimulator/iikb.app
out=shots/raw/parity
parts=" ${PARTS:-light dark app chats} "
step() { echo "== $1 $(date +%T)"; }
mkdir -p "$out"
export PHONE=${PHONE:-iPhone 17}
ID=$(scripts/sim ensure "$PHONE" "${PHONE// /-}")
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$ID" -derivedDataPath build/uitest -quiet
touch "$APP"
scripts/sim boot "$ID"
scripts/sim allow "$ID" paste
scripts/sim use "$ID" iikb
set -a; source shots/demo/env; set +a
scripts/sim fill "$ID"
group=$(xcrun simctl get_app_container "$ID" com.shahidy.iikb group.com.shahidy.iikb)

# Shoots each <prefix>-<name>.hold ParityShots leaves, the seconds it holds into the hold, while the key is still down.
shutter() {
  local hold
  while sleep 0.05; do
    for hold in "$out"/*.hold; do
      [ -e "$hold" ] || continue
      sleep "$(cat "$hold")"
      xcrun simctl io "$ID" screenshot "${hold%.hold}.png" >/dev/null 2>&1 || echo "no shot for $hold" >&2
      rm "$hold"
    done
  done
}

for appearance in light dark; do
  [[ $parts == *" $appearance "* ]] || continue
  step "$appearance"
  xcrun simctl ui "$ID" appearance "$appearance"
  for section in layers typing held swipe menu emoji gif clipboard transcripts dictation-listening dictation-writing; do
    voice=
    if [[ $section == dictation-* ]]; then
      /usr/bin/python3 scripts/voiceapp.py "$ID" "$group" "${section#dictation-}" &
      voice=$!
    fi
    shutter &
    shooter=$!
    # Each section in a run of its own, again once if it fails, since the simulator on GitHub's Macs now and then
    # stops answering a UI test's queries.
    for attempt in 1 2; do
      log=build/uitest/parity-$appearance-$section-$attempt.log
      if TEST_RUNNER_IIKB_SHOTS="$PWD/$out/$appearance" TEST_RUNNER_IIKB_STATES=$section xcodebuild test-without-building \
        -collect-test-diagnostics never -project iikb.xcodeproj -scheme iikb -destination "id=$ID" -derivedDataPath build/uitest \
        -only-testing:AppUITests/ParityShots >"$log" 2>&1; then
        break
      fi
      grep -E "error:|Test Case .*failed" "$log" || true
      [ "$attempt" = 1 ] || failed=1
    done
    kill "$shooter" ${voice:+"$voice"} 2>/dev/null || true
    wait 2>/dev/null || true
  done
  for shot in "$out/$appearance"-*.{png,json}; do
    [ -e "$shot" ] || continue
    name=${shot#"$out/$appearance"-}
    mv "$shot" "$out/${name%.*}-$appearance.${name##*.}"
  done
done

if [[ $parts == *" app "* ]]; then
  step app
  KEEP=1 scripts/sim phoneapp parity || failed=1
  KEEP=1 ARGS="-iikbScrollToEnd YES" scripts/sim phoneapp parity-end || failed=1
  for shot in shots/raw/phone/app/parity-*.png; do
    name=${shot##*/parity-}
    end=
    [[ $name == end-* ]] && name=${name#end-} end=-end
    mv "$shot" "$out/app-${name%-*}$end-${name##*-}"
  done
fi
PORT=${PORT:-2597}
[[ $parts == *" chats "* ]] && step chats
for appearance in light dark; do
  [[ $parts == *" chats "* ]] || break
  xcrun simctl ui "$ID" appearance "$appearance"
  for attempt in 1 2; do
    HOST=:: PORT=$PORT bun scripts/chats.ts >build/uitest/chats-$appearance-$attempt.log 2>&1 &
    stand=$!
    log=build/uitest/parity-$appearance-chats-$attempt.log
    TEST_RUNNER_IIKB_SHOTS="$PWD/$out/$appearance" TEST_RUNNER_IIKB_STATES=chats \
      TEST_RUNNER_IIKB_EXTENSION="http://localhost:$PORT" xcodebuild test-without-building -collect-test-diagnostics never \
      -project iikb.xcodeproj -scheme iikb -destination "id=$ID" -derivedDataPath build/uitest \
      -only-testing:AppUITests/ParityShots >"$log" 2>&1 && passed=1 || passed=
    kill "$stand" 2>/dev/null || true
    wait "$stand" 2>/dev/null || true
    [ -n "$passed" ] && break
    grep -E "error:|Test Case .*failed" "$log" || true
    [ "$attempt" = 1 ] || failed=1
  done
  for shot in "$out/$appearance"-*.{png,json}; do
    [ -e "$shot" ] || continue
    name=${shot#"$out/$appearance"-}
    mv "$shot" "$out/${name%.*}-$appearance.${name##*.}"
  done
done
step done
ls "$out"/*.png | wc -l
cp ~/Library/Logs/DiagnosticReports/*iikb* ~/Library/Logs/DiagnosticReports/*Keyboard* build/uitest/ 2>/dev/null || true
exit "${failed:-0}"
