#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
ID=$(scripts/sim ensure "iPhone 17" iPhone-17)
scripts/sim boot "$ID"
scripts/sim use "$ID" system
xcrun simctl spawn "$ID" defaults write com.apple.Preferences KeyboardPrediction -bool YES
xcrun simctl shutdown "$ID"
scripts/sim boot "$ID"
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$ID" -derivedDataPath build/uitest -quiet
mkdir -p shots/raw/caret
TEST_RUNNER_IIKB_PROBE_OUT="$PWD/shots/raw/caret/apple" \
  xcodebuild test-without-building -collect-test-diagnostics never -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
  -derivedDataPath build/uitest -only-testing:AppUITests/AppleCaretProbe 2>&1 | grep -E "error:|failed|Executed|passed" || true
cat shots/raw/caret/apple.txt
