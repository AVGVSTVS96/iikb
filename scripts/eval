#!/bin/bash
# Types the phrase corpus with simulated taps and prints word accuracy for the old and new correctors (AGENTS.md).
# Here on Linux it runs in a package of KeyboardCore, the word lists and Evaluation alone, and scores iikb's two
# keyboards; the UITextChecker baseline needs Apple's platforms, so on a Mac (scripts/ci scripts/eval) it scores that
# too. Both score real people's typing as well (realTaps, realTypos, realAutocorrect), which scripts/realtyping.py
# downloads into build/real the first time and again whenever the script changes, and the bar on many people's own
# writing (people). Here each test runs in its own process, and people in one per source, split and user. Optional
# argument: the tests whose names start with it (noise, biasedThumbs, real, people), or swipe: how well swipes are
# read on swipe.futo.org's test split and, in German, French and Spanish, its swipe-5 run (SwipeEvaluation; needs
# scripts/swipe data and languages, and SWIPE_DATA, takes minutes), which is only diffed against eval.expected's swipe
# lines, or languages: each other language's phrases (phrases.<id>.txt) typed
# on its own layout with its own words, downloaded from the release the manifest names into build/languages/, each
# language in its own process (about 12 minutes), only diffed against eval.expected's language lines, or owner: Bassim's
# own messages with his taps, memory and network (OwnerTyping), from scripts/owner.py's folder here, written the first
# time from the record and the backup, dev and test each in its own process, only diffed against eval.expected's owner
# lines. A full run must match eval.expected, its baseline lines only on a
# Mac; a change that moves the numbers updates that file in the same commit.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
src=$root/Packages/KeyboardModules
out=$root/build/eval.txt
mkdir -p "$root/build"
export REAL_DATA=${REAL_DATA:-$root/build/real} TEST_RUNNER_REAL_DATA=${REAL_DATA:-$root/build/real}
mirror=${IIKB_BACKUP:-$HOME/.local/share/iikb/backup}/mirror
if [ -f "$mirror/personal/en.network" ] && [ -f "$mirror/keyboard/support/typing-memory.json" ]; then
  export PHONE_NETWORK=$mirror/personal/en.network PHONE_MEMORY=$mirror/keyboard/support/typing-memory.json
fi
[ ! -f "$HOME/.local/share/iikb/record.jsonl" ] || export RECORD=$HOME/.local/share/iikb/record.jsonl
unset OWNER_DATA
if [ "${1:-}" = owner ]; then
  export OWNER_DATA=$HOME/.local/share/iikb/owner
  [ -f "$OWNER_DATA/test/text.txt" ] || python3 -I "$root/scripts/owner.py" "$OWNER_DATA"
fi
case "${1:-real}" in real* | people) [ "$REAL_DATA/taps.txt" -nt "$root/scripts/realtyping.py" ] || python3 -I "$root/scripts/realtyping.py" "$REAL_DATA" ;; esac
if [ "${1:-}" = languages ] || [ "${1:-}" = swipe ]; then
  export LANGUAGES=$root/build/languages
  python3 - "$root/Packages/KeyboardModules/Sources/KeyboardStore/Resources/Languages/manifest.json" "$LANGUAGES" <<'PY'
import hashlib, json, os, sys, urllib.request
os.makedirs(sys.argv[2], exist_ok=True)
for entry in json.load(open(sys.argv[1]))["lexicons"]:
    path = os.path.join(sys.argv[2], entry["id"] + ".lexicon")
    if not os.path.exists(path) or hashlib.sha256(open(path, "rb").read()).hexdigest() != entry["sha256"]:
        urllib.request.urlretrieve(entry["url"], path)
PY
fi
if [ "$(uname)" = Darwin ]; then
  cd "$src"
  ID=$("$root/scripts/sim" ensure "iPhone 17" iPhone-17)
  xcodebuild test -collect-test-diagnostics never -scheme KeyboardModules-Package -destination "id=$ID" -derivedDataPath ../../build/tests \
    -configuration Release ENABLE_TESTABILITY=YES \
    -only-testing:KeyboardUITests/Evaluation${1:+/$1()} 2>&1 | grep -E "error:|EVAL|✘" | tee "$out"
  scored=.
else
  pkg=$root/build/eval
  rm -rf "$pkg/Sources/KeyboardUI"
  mkdir -p "$pkg/Sources" "$pkg/Tests/KeyboardUITests"
  ln -sfn "$src/Sources/KeyboardCore" "$pkg/Sources/KeyboardCore"
  ln -sfn "$src/Sources/KeyboardEnglish" "$pkg/Sources/KeyboardEnglish"
  for file in "$src"/Tests/KeyboardUITests/{Evaluation.swift,RealTyping.swift,PeopleTyping.swift,OwnerTyping.swift,SwipeEvaluation.swift,chat.txt} "$src"/Tests/KeyboardUITests/phrases*.txt; do ln -sf "$file" "$pkg/Tests/KeyboardUITests/"; done
  cat > "$pkg/Package.swift" <<'SWIFT'
// swift-tools-version: 6.2
import PackageDescription

let package = Package(name: "Eval", targets: [
    .target(name: "KeyboardCore"),
    .target(name: "KeyboardEnglish", dependencies: ["KeyboardCore"], exclude: ["Resources/LEXICON-LICENSE", "Resources/NETWORK-LICENSE"], resources: [.copy("Resources/en.lexicon"), .copy("Resources/en.network"), .copy("Resources/en.swipe"), .copy("Resources/SWIPE-LICENSE"), .copy("Resources/emoji.txt"), .copy("Resources/emoji-search.txt")]),
    .testTarget(name: "KeyboardUITests", dependencies: ["KeyboardEnglish"], resources: [.copy("phrases.txt"), .copy("phrases.es.txt"), .copy("phrases.fr.txt"), .copy("phrases.de.txt"), .copy("phrases.pt.txt"), .copy("phrases.it.txt"), .copy("phrases.sv.txt"), .copy("chat.txt")]),
])
SWIFT
  cd "$pkg"
  if [ "${1:-}" = languages ]; then
    swift build -c release -Xswiftc -enable-testing --build-tests 2>&1 | grep -E "error:" || true
    for id in $(python3 -c 'import json, sys; print(" ".join(l["id"] for l in json.load(open(sys.argv[1]))["lexicons"]))' "$root/Packages/KeyboardModules/Sources/KeyboardStore/Resources/Languages/manifest.json"); do
      LANGUAGE=$id .build/release/KeyboardUITests-test-runner --testing-library swift-testing --filter Evaluation/languages > "$root/build/eval.$id.txt" 2>&1 &
    done
    wait
    cat "$root"/build/eval.*.txt | grep -E "error:|EVAL|✘" | tee "$out"
  elif [ "${1:-}" = owner ]; then
    swift build -c release -Xswiftc -enable-testing --build-tests 2>&1 | grep -E "error:" || true
    for split in dev test; do
      OWNER_SPLIT=$split .build/release/KeyboardUITests-test-runner --testing-library swift-testing --filter Evaluation/owner > "$root/build/owner.$split.txt" 2>&1 &
    done
    wait
    cat "$root"/build/owner.*.txt | grep -E "error:|EVAL|✘" | tee "$out"
  else
    swift build -c release -Xswiftc -enable-testing --build-tests 2>&1 | grep -E "error:" || true
    runner=.build/release/KeyboardUITests-test-runner
    rm -f "$root"/build/eval.part.*.txt
    for test in $("$runner" --testing-library swift-testing --list-tests | sed -n 's|^KeyboardUITests\.Evaluation/\(.*\)()$|\1|p' | grep "^${1:-}"); do
      if [ "$test" = people ]; then
        for source in enron nus; do for split in dev test; do for user in new learned; do
          PEOPLE="$source $split $user" "$runner" --testing-library swift-testing --filter 'Evaluation/people\(' > "$root/build/eval.part.people-$source-$split-$user.txt" 2>&1 &
        done; done; done
      else
        "$runner" --testing-library swift-testing --filter "Evaluation/$test\\(" > "$root/build/eval.part.$test.txt" 2>&1 &
      fi
    done
    wait
    cat "$root"/build/eval.part.*.txt | grep -E "error:|EVAL|✘" | tee "$out"
  fi
  scored='keyboard=(decoder|learning)|EVAL (emoji|predict|thumbs learned|strayKeys|real|people)'
fi
if [ "${1:-}" = languages ]; then
  diff -u <(grep '^EVAL language' "$root/scripts/eval.expected") <(grep '^EVAL language' "$out") && echo "EVAL languages match eval.expected"
  exit
fi
if [ "${1:-}" = owner ]; then
  diff -u <(grep '^EVAL owner' "$root/scripts/eval.expected") <(grep '^EVAL owner' "$out" | sort) && echo "EVAL owner matches eval.expected"
  exit
fi
if [ "${1:-}" = people ]; then
  diff -u <(grep '^EVAL people' "$root/scripts/eval.expected") <(grep '^EVAL people' "$out" | sort) && echo "EVAL people matches eval.expected"
  exit
fi
if [ "${1:-}" = swipe ]; then
  diff -u <(grep '^EVAL swipe' "$root/scripts/eval.expected" | sort) <(grep '^EVAL swipe' "$out" | sort) && echo "EVAL swipe matches eval.expected"
  exit
fi
[ -z "${1:-}" ] || exit 0
diff -u <(grep -E "$scored" "$root/scripts/eval.expected" | grep -v '^EVAL swipe' | grep -vE '^EVAL (language|owner)' | sort) <(grep '^EVAL' "$out" | grep -vE '^EVAL (latency|phone)' | grep -v '^EVAL swipe' | sort) && echo "EVAL matches eval.expected"
