#!/bin/bash
# Runs on a Mac. Everything a batch of changes needs, at once, on one simulator, the iPhone Duo folded unless named:
# one build of the app and every test, KeyboardUI's package tests, every UI test with Full Access on the simulator and
# shots/demo's made-up transcripts in the app (each test capped at 5 minutes, as GitHub's Macs need, a failure retried
# once) but the four that need another setup, the voice test with scripts/voiceapp.py standing in for the app, and the
# screenshot tests again in dark, into shots/raw/verify/. PARTS names the parts to run (package typing panels rest dark
# voice), so a push to main runs them side by side on four Macs.
# scripts/verify ["iPhone 17"] [iPhone-17] (OPEN=1 unfolds; ORIENTATION=landscape; PARTS="typing dark")
set -euo pipefail
cd "$(dirname "$0")/.."
NAME=${1:-iPhone Duo}
TYPE=${2:-iPhone-Duo}
export APP=build/uitest/Build/Products/Debug-iphonesimulator/iikb.app
ID=$(scripts/sim ensure "$NAME" "$TYPE")
shots=$PWD/shots/raw/verify
logs=build/uitest/verify
rm -rf "$shots" "$logs"
mkdir -p "$shots" "$logs"
step() { echo "== $1 $(date +%T)"; }
summary() { grep -E "error:|✘|XCTAssert|Test [Cc]ase .*failed|Test run with|Executed .* tests" "$1" | sort -u || true; }

step build
xcodegen generate -q
xcodebuild build-for-testing -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
  -derivedDataPath build/uitest -quiet

scripts/sim boot "$ID"
scripts/sim allow "$ID"
scripts/sim use "$ID" iikb
[ -n "${OPEN:-}" ] && scripts/sim unfold "$ID"
python3 shots/demo/make.py build/demo
TRANSCRIPTS=build/demo/transcripts.jsonl RECORDINGS=build/demo/recordings scripts/sim fill "$ID"
group=$(xcrun simctl get_app_container "$ID" com.shahidy.iikb group.com.shahidy.iikb)

uitest() {
  local log=$logs/$1.log; shift
  mkdir -p "$prefix"
  TEST_RUNNER_IIKB_SHOTS=$prefix TEST_RUNNER_IIKB_ORIENTATION=${ORIENTATION:-portrait} \
    xcodebuild test-without-building -collect-test-diagnostics never -project iikb.xcodeproj -scheme iikb -destination "id=$ID" \
    -derivedDataPath build/uitest -test-timeouts-enabled YES -default-test-execution-time-allowance 300 \
    -retry-tests-on-failure -test-iterations 2 -collect-test-diagnostics never "$@" > "$log" 2>&1 || failed=1
  summary "$log"
}

# Messages stops answering in a slim simulator once a conversation opens, before iikb comes into it.
messages=AppUITests/ToolPanelTests/testAHeldGifDragsIntoTheMessage
typing=(TypingTests FirstTapTests SwipeTests FastTypingTests SuggestionTests OneHandedTests)
panels=(PanelTests ToolPanelTests)
# The real iPhone's chats (scripts/chatdevice), Control Center with its widget services (scripts/controltest), and a
# recording said by a macOS voice (scripts/sharetest); the voice test is its own part.
apart=(VoiceTests ChatBoxDeviceTests MicControlTests RecordingShareTests)
only() { printf -- '-only-testing:AppUITests/%s ' "$@"; }
skip() { printf -- '-skip-testing:AppUITests/%s ' "$@"; }
appearance() {
  scripts/sim boot "$ID"
  xcrun simctl ui "$ID" appearance "$1"
  prefix=$shots/$1/iikb
}

for part in ${PARTS:-package typing panels rest dark voice}; do
  step "$part"
  case $part in
    package) prefix=$shots/package; uitest package -only-testing:KeyboardUITests -skip-testing:KeyboardUITests/Evaluation ;;
    typing) appearance light; uitest typing $(only "${typing[@]}") ;;
    panels) appearance light; uitest panels $(only "${panels[@]}") -skip-testing:"$messages" ;;
    rest) appearance light; uitest rest -only-testing:AppUITests $(skip "${typing[@]}" "${panels[@]}" "${apart[@]}") ;;
    dark) appearance dark; uitest dark $(only "${panels[@]}" SuggestionShots) -skip-testing:"$messages" ;;
    voice)
      for look in light dark; do
        appearance "$look"
        /usr/bin/python3 scripts/voiceapp.py "$ID" "$group" &
        app=$!
        uitest "voice-$look" $(only VoiceTests)
        kill "$app" 2>/dev/null || true
        wait "$app" 2>/dev/null || true
      done ;;
    *) echo "no part $part" >&2; exit 2 ;;
  esac
done
step "done, $([ -z "${failed:-}" ] && echo passed || echo failed)"
exit "${failed:-0}"
